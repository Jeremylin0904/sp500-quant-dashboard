{
  "model": "Fama-French 5-Factor + Momentum (UMD)",
  "source": "Kenneth R. French Data Library (monthly, USD)",
  "factor_definitions": {
    "Mkt-RF": "市場超額：全美股市值加權報酬 − 一個月國庫券(RF)",
    "SMB": "Small-Minus-Big：小型股 − 大型股（規模）",
    "HML": "High-Minus-Low：高淨值市價比(價值) − 低(成長)",
    "RMW": "Robust-Minus-Weak：高 − 低營業獲利能力",
    "CMA": "Conservative-Minus-Aggressive：低 − 高資產成長（投資）",
    "Mom": "Momentum/UMD：前 2–12 月贏家 − 輸家",
    "RF": "一個月美國國庫券利率"
  },
  "factor_definitions_en": {
    "Mkt-RF": "Market excess: US cap-weighted market return − one-month T-bill (RF)",
    "SMB": "Small-Minus-Big: small-cap − large-cap (size)",
    "HML": "High-Minus-Low: high book-to-market (value) − low (growth)",
    "RMW": "Robust-Minus-Weak: high − low operating profitability",
    "CMA": "Conservative-Minus-Aggressive: low − high asset growth (investment)",
    "Mom": "Momentum/UMD: 2-12 month winners − losers",
    "RF": "One-month US T-bill rate"
  },
  "regression_spec": "(R_strategy - RF) = alpha + b·[Mkt-RF, SMB, HML, RMW, CMA, Mom] + e",
